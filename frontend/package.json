{
  "name": "leela-editor",
  "private": true,
  "description": "Browser build inputs for the leela IDE (CodeMirror 6 editor, xterm.js terminal, htmx). Build with `npm ci && npm run build`; package-lock.json pins every version, so the output in `leela/vendor/` is the same bytes each time. The output is committed so users never need node.",
  "scripts": {
    "build": "npm run build:editor && npm run build:term && npm run build:termcss && npm run build:htmx",
    "build:editor": "esbuild editor.js --bundle --format=iife --global-name=LeeCM --minify --outfile=../leela/vendor/lee-cm6.js",
    "build:term": "esbuild term.js --bundle --format=iife --minify --outfile=../leela/vendor/lee-term.js",
    "build:termcss": "cp node_modules/@xterm/xterm/css/xterm.css ../leela/vendor/lee-term.css",
    "build:htmx": "cp node_modules/htmx.org/dist/htmx.min.js ../leela/vendor/htmx.min.js"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.1",
    "@codemirror/language": "^6.10.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@lezer/highlight": "^1.2.3",
    "htmx.org": "2.0.7"
  }
}
