diff --git a/procure/core.py b/procure/core.py
index 4a1c2f0..9de77b1 100644
--- a/procure/core.py
+++ b/procure/core.py
@@ -1,7 +1,13 @@
 def bands(pos, cut=2000):
     "Split a PO extract into the tail below `cut` and the rest."
     tail = pos[pos.value_eur < cut]
     return tail, pos.drop(tail.index)
+
+
+def triage(po, cut=2000, trusted=frozenset()):
+    "Whether a PO can skip the approval chain."
+    return po.value_eur < cut and po.supplier in trusted and po.contract_id is not None
diff --git a/tests/test_triage.py b/tests/test_triage.py
new file mode 100644
index 0000000..b21e8ac
--- /dev/null
+++ b/tests/test_triage.py
@@ -0,0 +1,11 @@
+from procure.core import triage
+
+
+def test_only_contracted_suppliers_skip_the_chain():
+    po = Row(value_eur=1200, supplier='acme', contract_id='C-9')
+    assert triage(po, trusted={'acme'})
+    assert not triage(po, trusted=set())
+
+
+def test_a_po_with_no_contract_stays_in_the_chain():
+    assert not triage(Row(value_eur=1200, supplier='acme', contract_id=None), trusted={'acme'})
