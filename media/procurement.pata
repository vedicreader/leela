  {
   "id": "s-interview",
   "flavour": "pata:source",
   "props": {
    "title": "Buyer interviews (7)",
    "text": "Every buyer named the same two: re-keying supplier data from email, and chasing approvals that nobody disputes."
   },
   "frame": "f-know",
   "mode": "keep",
   "x": 932.0,
   "y": 426.0,
   "w": 380.0,
   "h": 133.0
  },
  {
   "id": "p-synth",
   "flavour": "pata:prompt",
   "props": {
    "source": "Where does the 10% most plausibly come from? Use only the three sources here.",
    "context": {
     "scope": "frame",
     "pins": [
      "goal"
     ],
     "budget": 12000
    },
    "reply": "Tail spend is the only pool big enough. 34% of POs are under EUR 2,000 and carry a three-person approval chain that the audit found nobody ever rejects. Auto-approving that band would take roughly a third of PO volume off the buyers without touching the categories where negotiation earns money. That is worth about 12% of buyer time on the interview evidence, which clears the 10% target with room."
   },
   "frame": "f-know",
   "x": 1338.0,
   "y": 87.0,
   "w": 380.0,
   "h": 301.0
  },
