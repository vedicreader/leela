   "id": "s-hackett",
   "flavour": "pata:source",
   "props": {
    "title": "Hackett Group: procurement benchmark 2025",
    "url": "https://example.org/hackett-2025",
    "text": "Top-quartile organisations process 2.3x the POs per buyer of the median. The gap is almost entirely low-value tail spend that never needed a buyer."
   },
   "frame": "f-know",
   "x": 932.0,
   "y": 87.0,
   "w": 380.0,
   "h": 154.0
  },
  {
   "id": "s-audit",
   "flavour": "pata:source",
   "props": {
    "title": "Internal audit, Q3 FY25",
    "path": "drive/audit-q3.pdf",
    "text": "34% of purchase orders raised in Q3 were under EUR 2,000. Median approval chain for those was 3 people and 6.2 days."
   },
   "frame": "f-know",
   "x": 932.0,
   "y": 267.0,
   "w": 380.0,
   "h": 133.0
