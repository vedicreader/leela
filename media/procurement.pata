  {
   "id": "c-band",
   "flavour": "pata:code",
   "props": {
    "source": "#|export\ndef bands(pos, cut=2000):\n    \"Split a PO extract into the tail below `cut` and the rest.\"\n    tail = pos[pos.value_eur < cut]\n    return tail, pos.drop(tail.index)",
    "lang": "python",
    "execution_count": 3,
    "execution_ms": 41.2,
    "outputs": [
     {
      "output_type": "stream",
      "text": ""
     }
    ]
   },
   "frame": "f-base",
   "mode": "keep",
   "x": 60.0,
   "y": 862.0,
   "w": 380.0,
   "h": 175.0
  },
  {
   "id": "c-share",
   "flavour": "pata:code",
   "props": {
    "source": "tail, rest = bands(pos)\nlen(tail) / len(pos), tail.approvers.median()",
    "lang": "python",
    "execution_count": 4,
    "execution_ms": 118.0,
    "outputs": [
     {
      "output_type": "execute_result",
      "data": {
       "text/plain": "(0.341, 3.0)"
      }
     }
    ]
   },
   "frame": "f-base",
   "x": 60.0,
   "y": 1063.0,
   "w": 380.0,
   "h": 154.0
  },
  {
   "id": "c-cycle",
   "flavour": "pata:code",
   "props": {
    "source": "tail.groupby('region').cycle_days.mean()",
    "lang": "python",
    "execution_count": 5,
    "execution_ms": 96.5,
    "outputs": [
     {
      "output_type": "error",
      "ename": "AttributeError",
      "evalue": "'DataFrame' object has no attribute 'cycle_days'"
     }
