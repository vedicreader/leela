   },
   "frame": "f-base",
   "x": 466.0,
   "y": 724.0,
   "w": 380.0,
   "h": 133.0
  },
  {
   "id": "p-fix",
   "flavour": "pata:prompt",
   "props": {
    "source": "Fix the cell above. Leave the result as `cycle`.",
    "context": {
     "scope": "upstream",
     "pins": [
      "d-pos"
     ],
     "budget": 8000
    },
    "reply": "`cycle_days` is not a column. `raised_at` and `approved_at` are, so I derived it and bound the regional means as `cycle`."
   },
   "frame": "f-base",
   "x": 466.0,
   "y": 883.0,
   "w": 380.0,
