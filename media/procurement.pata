   "w": 846.0,
   "h": 468.0
  },
  {
   "id": "c-rule",
   "flavour": "pata:code",
   "props": {
    "source": "#|export\ndef triage(po, cut=2000, trusted=frozenset()):\n    \"Whether a PO can skip the approval chain.\"\n    return po.value_eur < cut and po.supplier in trusted and po.contract_id is not None",
    "lang": "python",
    "execution_count": 7,
    "execution_ms": 12.0,
    "outputs": []
   },
   "frame": "f-proto",
   "x": 932.0,
   "y": 724.0,
   "w": 380.0,
   "h": 154.0
  },
  {
   "id": "c-backtest",
   "flavour": "pata:code",
   "props": {
    "source": "auto = tail.apply(triage, axis=1, trusted=preferred)\nauto.mean()",
    "lang": "python",
    "execution_count": 8,
    "execution_ms": 402.0,
    "outputs": [
     {
      "output_type": "execute_result",
      "data": {
       "text/plain": "0.79"
      }
     }
    ]
   },
   "frame": "f-proto",
   "x": 932.0,
   "y": 904.0,
   "w": 380.0,
   "h": 175.0
  },
  {
   "id": "p-risk",
   "flavour": "pata:prompt",
   "props": {
    "source": "What would have gone wrong if this rule had run in Q3? Check it against the audit.",
    "context": {
     "scope": "upstream",
     "pins": [
      "s-audit",
      "goal"
     ],
     "budget": 10000
    },
    "reply": "79% of the tail clears the rule, which is 27% of all POs. Against the Q3 extract that is 14 POs the audit flagged for split ordering, all from one supplier. Cap the rule per supplier per month and those 14 stay in the chain."
   },
   "frame": "f-proto",
   "x": 1338.0,
